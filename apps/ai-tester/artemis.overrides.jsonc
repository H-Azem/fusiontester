{
  // Deltas merged on top of the agent's own bundled config at start-up.
  //
  // The lane's model endpoint is OpenAI-compatible, so every node uses the
  // "openai" provider pointing at OPENAI_BASE_URL. The literal "@@MODEL@@" is
  // replaced with the run's model and "@@MAX_TURNS@@" with the run's step
  // budget before the file is written.
  "default": {
    "provider": "openai",
    "model": "@@MODEL@@",
    "fallback": {
      "provider": "openai",
      "model": "@@MODEL@@"
    }
  },
  "nodes": {
    // The utility nodes pin their own model instead of following the run's.
    //
    // Both ask for strict JSON, and the run's endpoint is often a router alias
    // that resolves to whatever is available: when it hands back prose, the
    // node's reply fails to parse and the whole run pauses waiting for a resume
    // signal. Naming the model trades "whatever the operator configured" for a
    // reply the lane can actually read — the operator's model still drives the
    // planner and the operator itself, which is what the agent's reasoning is.
    "object_detector": {
      "provider": "openai",
      "model": "gemini/gemini-3.8-flash",
      "fallback": {
        "provider": "openai",
        "model": "gemini/gemini-3.5-flash-lite"
      }
    },
    "hopper": {
      "provider": "openai",
      "model": "gemini/gemini-3.5-flash-lite",
      "fallback": {
        "provider": "openai",
        "model": "gemini/gemini-3.8-flash"
      }
    }
  },
  "agent": {
    "flash": {
      // No turn cap: a long journey that keeps making progress should not be cut
      // off at a fixed number of steps. The budget is spent in tokens instead,
      // enforced by the lane runner from the settings.
      "max_turns": 0,
      // The flash explorer delegates to the object detector, which wants a
      // Gemini-ER model. The pro tier runs a plain multi-turn loop against the
      // configured model instead.
      "explorer_mode": "pro",
      // The step summarizer builds a Google client even when a model is named.
      "step_summarizer": {
        "enabled": false,
        "model": "@@MODEL@@"
      }
    },
    "memory": {
      "chunking": {
        // Compresses history into JSON capsules, so it has the same need as the
        // utility nodes above.
        "model": "gemini/gemini-3.5-flash-lite"
      }
    },
    "video_analyzer": {
      "enabled": false
    },
    "pro": {
      "video_analyzer": {
        "enabled": false
      }
    }
  }
}
