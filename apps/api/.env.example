# Copy to .env and adjust. Never commit .env.

PORT=4000
HOST=127.0.0.1
NODE_ENV=development

# Origin the dashboard is served from. Login origin checks compare against this.
WEB_ORIGIN=http://localhost:3000

# Leave false unless a reverse proxy you control sets X-Forwarded-For.
# Enabling it when a client can set that header lets attackers spoof IPs
# and bypass IP blocking entirely.
TRUST_PROXY=false

# Default admin, created on first boot if it does not exist.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Failed attempts before an IP is blocked, the window they are counted in,
# and how long the block lasts.
AUTH_MAX_FAILED_ATTEMPTS=3
AUTH_FAILED_WINDOW_MINUTES=60
AUTH_BLOCK_HOURS=6

SESSION_TTL_HOURS=12
CAPTCHA_TTL_MINUTES=10

# Embedded Postgres data directory (PGlite). Relative paths resolve to apps/api.
# PGLITE_DIR=./.data/pglite

# Encrypts stored third-party credentials, such as the GitLab token.
# Set this in production and keep a backup: losing it makes stored credentials
# undecryptable, and changing it invalidates the stored GitLab token.
# When unset, a key is generated at apps/api/.data/app-secret, which is
# convenient locally but should not be relied on for a deployment.
# APP_SECRET=use-a-long-random-value-here
