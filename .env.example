# Copy to .env next to docker-compose.yml. Never commit .env.

# Public URL the dashboard is served from. This must match exactly, including
# scheme: login origin checks compare against it, and the session cookie is
# scoped to it. A mismatch shows up as a successful login that bounces straight
# back to the sign-in page.
WEB_ORIGIN=https://tester.example.com

# Encrypts the stored GitLab and AI tokens. Losing or changing it makes every
# stored credential unreadable, so back it up somewhere safe.
# Generate one with: openssl rand -base64 48
APP_SECRET=

# Credentials for private `git:` packages declared in the pubspec of the apps
# you test. A GitLab token with read_repository is enough. Leave both blank if
# your apps have no private pub dependencies.
GIT_HOST=git.sunshineteam.ca
GIT_TOKEN=
